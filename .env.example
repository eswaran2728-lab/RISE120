# Copy to .env.local (untracked) and fill in. Never commit real values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# OAuth *Web application* client ID from Google Cloud (not the Android client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public build settings for purchases and ads (set as EAS environment variables for the development
# environment; leave unset locally to run without purchases and with Google test ads in dev builds).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_UNIT_ID=
# Read at build time by app.config.js (not bundled into the app code).
ADMOB_ANDROID_APP_ID=
