{
  "expo": {
    "name": "Rise120",
    "slug": "eswar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rise120",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.eswaran2728.rise120",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-localization",
      "@react-native-google-signin/google-signin",
      ["expo-image-picker", { "cameraPermission": false, "microphonePermission": false }],
      ["expo-camera", { "cameraPermission": "Allow Rise120 to use the camera to scan food barcodes.", "recordAudioAndroid": false }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "206d4a44-7cdc-4e01-bf26-fd064abb957a"
      }
    },
    "owner": "eswaran0321s-team"
  }
}
